# Server & Region Identity
PORT=3000
REGION=mumbai

# Cache Configuration (redis | memory — use "memory" only for local no-Redis unit/smoke tests)
CACHE_DRIVER=redis
REDIS_URL=redis://redis_region1:6379
# Set REDIS_PRIMARY_URL when running a regional replica node (e.g. Region 2 -> redis://redis_region1:6379)
REDIS_PRIMARY_URL=
REDIS_AUTO_PROMOTE=true
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT_MS=50

# Security Secrets (replace with strong 32+ byte random secrets for cloud deployment)
HMAC_SECRET=aadhaar-prototype-aua-hmac-secret-2026
AES_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Security & Lifecycle Toggles
REQUIRE_HMAC=true
HMAC_WINDOW_SEC=60
OTP_TTL_SEC=300
REPLAY_TTL_SEC=60

# Mock SMS Gateway Behavior (true returns demoOtp in HTTP response for testing/demo)
DEMO_RETURN_OTP=true
LOG_MOCK_SMS=true
