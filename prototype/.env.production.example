# Production AWS EC2 Environment Template
# Copy to .env (never commit .env!) and populate secrets via `openssl rand -hex 32`

NGINX_PORT=80
NGINX_HTTPS_PORT=443

# Strong 256-bit secrets (generate with: openssl rand -hex 32)
HMAC_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET
AES_KEY=REPLACE_WITH_64_HEX_CHAR_AES_KEY

# Security & Lifecycle Settings
REQUIRE_HMAC=true
HMAC_WINDOW_SEC=60
OTP_TTL_SEC=300
REPLAY_TTL_SEC=60
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT_MS=50

# Set DEMO_RETURN_OTP=false in strict production; set true only during evaluator API demos
DEMO_RETURN_OTP=true
LOG_MOCK_SMS=false

